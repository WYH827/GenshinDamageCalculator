# Local dev/preview includes an Enka proxy; no values are required locally.
# UID import defaults to Cloudflare -> MicroGG page JSON; all three proxy choices use this origin.
# VITE_ENKA_API_BASE=https://enka-api.wyh827.workers.dev
# VITE_STATIC_HOST=true
# VITE_SITE_PUBLISHED=true
# VITE_SITE_URL=https://wyh827.github.io/GenshinDamageCalculator/
# VITE_REPOSITORY_URL=https://github.com/WYH827/GenshinDamageCalculator
# Cloudflare all-in-one build forces VITE_STATIC_HOST=false and uses /api/enka on the same site.
