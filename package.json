{
  "name": "teyvat-damage-studio",
  "version": "0.1.0",
  "description": "原神四人队伍参数编辑、效果与时间轴工作台",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:presets && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "check:presets": "vitest run src/official-presets.test.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir verification/cloudflare-dry-run"
  },
  "keywords": [],
  "author": "WYH827",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "private": true
}
