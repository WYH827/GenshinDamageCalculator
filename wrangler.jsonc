{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teyvat-damage-studio",
  "main": "deploy/site-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "build": {
    "command": "npm run build:cloudflare",
  },
}
